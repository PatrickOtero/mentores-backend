generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model mentors {
  id               String         @id @default(uuid())
  history          history[]
  fullName         String
  dateOfBirth      DateTime
  password         String
  email            String         @unique
  emailConfirmed   Boolean        @default(false)
  specialties      String[]
  role             String?
  aboutMe          String?
  gender           String?        @default("")
  registerComplete Boolean        @default(false)
  profile          String?
  profileKey       String?
  accessAttempt    Int?           @default(0)
  code             String?        @unique
  defaultProfile   String?
  isProfilePaused  Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now())
  deleted          Boolean        @default(false)
  deactivatedDays  Int            @default(0)
  testimony        testimony?
  calendlyInfo     calendlyInfo?  @relation("MentorCalendlyInfo")
  deactivatedAt DateTime?
  accountDeletionFeedback accountDeletionFeedback?
  mentorshipFeedbacks mentorshipFeedback[]

  @@index([id])
}

model calendlyInfo {
  id                   String    @id @default(uuid())
  mentorId            String    @unique
  calendlyUserUuid    String?
  calendlyRefreshToken String?
  calendlyAccessToken  String?
  accessTokenExpiration DateTime?
  calendlyName        String?
  agendaName          String?

  mentor              mentors?   @relation("MentorCalendlyInfo", fields: [mentorId], references: [id],onDelete: Cascade )
}

model users {
  id             String    @id @default(uuid())
  fullName       String
  dateOfBirth    DateTime
  password       String
  gender         String?
  aboutMe        String?
  copiedAboutMeFromMentor Boolean @default(false)
  specialties    String[]  @default([])
  registerComplete Boolean @default(false)
  email          String    @unique
  emailConfirmed Boolean   @default(false)
  profile        String?
  profileKey     String?
  copiedProfileFromMentor Boolean @default(false)
  accessAttempt  Int?      @default(0)
  code           String?   @unique
  defaultProfile String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
  deleted        Boolean   @default(false)
  deactivatedDays Int      @default(0)
  deactivatedAt  DateTime?
  history        history[]
  mentorshipFeedbacks mentorshipFeedback[]

  @@index([id])
}

model history {
  id          String  @id @default(uuid())
  mentee_id   String
  mentor_id   String
  users       users   @relation(fields: [mentee_id], references: [id])
  mentors     mentors @relation(fields: [mentor_id], references: [id])
  status      String  @default("COMPLETED")
  duration    String?
  happened_at String  @default("")
  eventName   String?
  description String?
  joinUrl     String?
  cancelUrl   String?
  rescheduleUrl String?
  timezone    String?
  schedulingUrl String?
  inviteeName String?
  inviteeEmail String @default("")
  startTime   DateTime?
  endTime     DateTime?
  calendlyEventUri String? @unique
  calendlyEventUuid String? @unique
  calendlyInviteeUri String?
  feedbackRequestedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mentorshipFeedback mentorshipFeedback?

  @@index([mentee_id, endTime])
  @@index([mentor_id, endTime])
}

model mentorshipFeedback {
  id                       String   @id @default(uuid())
  history_id               String   @unique
  mentor_id                String
  mentee_id                String
  mentoringRating          Int
  mentorClarityRating      Int
  mentorSupportRating      Int
  goalProgressRating       Int
  platformExperienceRating Int
  comment                  String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  history                  history  @relation(fields: [history_id], references: [id], onDelete: Cascade)
  mentor                   mentors  @relation(fields: [mentor_id], references: [id], onDelete: Cascade)
  mentee                   users    @relation(fields: [mentee_id], references: [id], onDelete: Cascade)

  @@index([mentee_id, createdAt])
  @@index([mentor_id, createdAt])
}

model testimony {
  id          String   @id @default(uuid())
  mentor      mentors? @relation(fields: [mentor_id], references: [id])
  mentor_id   String   @unique
  userName    String
  role        String
  description String
  imageUrl    String?  @default("")
  createdAt   String   @default("")
  updatedAt   String   @default("")
}

model accountDeletionFeedback {
  id                     String   @id @default(uuid())
  mentor                 mentors? @relation(fields: [mentor_id], references: [id])
  mentor_id              String   @unique
  reasonOption           String
  reasonText             String?
  usabilityRating        String
  satisfactionRating     String
  userExperienceFeedback String?
  createdAt              DateTime @default(now())
}
