<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body style="font-family: Arial, sans-serif; color: #323232; background: #f5f5f7; margin: 0; padding: 32px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center">
          <table width="100%" style="max-width: 640px; background: #ffffff; padding: 40px; border-radius: 12px;">
            <tr>
              <td>
                <h2 style="margin: 0 0 16px; color: #003986;">{{title}}</h2>
                <p style="margin: 0 0 16px;">Olá, {{name}}.</p>
                <p style="margin: 0 0 16px;">{{description}}</p>
                <p style="margin: 0;">Por favor, não responda a este e-mail.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
