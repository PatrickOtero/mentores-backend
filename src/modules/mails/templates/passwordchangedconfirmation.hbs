<html>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <center style="width: 100%;">
      <div
        style="
          max-width: 840px;
          margin: 0 auto;
          padding: 40px 20px;
        "
      >
        <div
          style="
            background-color: #03123b;
            border-radius: 8px;
            padding: 30px;
          "
        >
          <h1
            style="
              margin: 0;
              padding: 20px;
              background-color: #4c7ee9;
              border-radius: 5px;
              color: #ffffff;
              font-size: 28px;
              text-align: center;
            "
          >
            Portal de Mentorias
          </h1>

          <div
            style="
              margin-top: 25px;
              padding: 30px;
              background-color: #ffffff;
              border-radius: 8px;
              text-align: center;
            "
          >
            <h2
              style="
                margin-top: 0;
                color: #03123b;
                font-size: 24px;
              "
            >
              Senha alterada com sucesso!
            </h2>

            <p
              style="
                color: #333333;
                font-size: 16px;
                line-height: 1.6;
              "
            >
              Olá, {{name}}!
            </p>

            <p
              style="
                color: #555555;
                font-size: 16px;
                line-height: 1.6;
              "
            >
              Informamos que a senha da sua conta no
              <strong>Portal de Mentorias</strong>
              foi alterada com sucesso.
            </p>

            <p
              style="
                color: #555555;
                font-size: 16px;
                line-height: 1.6;
              "
            >
              Caso você não tenha realizado essa alteração,
              recomendamos que entre em contato com o suporte.
            </p>
          </div>

          <p
            style="
              margin: 25px 0 0;
              color: #ffffff;
              font-size: 12px;
              text-align: center;
            "
          >
            Portal de Mentorias
          </p>
        </div>
      </div>
    </center>
  </body>
</html>

